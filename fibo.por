algoritmo
declare a, b, temp, cont numerico
a <- 0
b <- 1
cont <- 0
escreva("Seq. de fibo... ate o termo 50º")
a <-1
b <-1
cont <- 2
enquanto (cont <= 50) faca
			inicio
				escreva a
				temp <- a+b
				a <- b
				b <- temp
			     cont <- (cont + 1)
			fim
fim_algoritmo
      
      
