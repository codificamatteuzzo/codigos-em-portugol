algoritmo
declare
	v[10], somatorio, i numerico
	
para i <- 1 ate 10 faca
	inicio
		escreva "Entre com o valor da posicao [",i, "] = "
		leia v[i]
	fim
	escreva "Elementos digitados: "
para i <- 1 ate 10 faca
	inicio
		somatorio <- v[i]+ somatorio
	fim
	
		escreva "A media aritmetica sera: ",(somatorio/10) 
		
		
fim_algoritmo.
