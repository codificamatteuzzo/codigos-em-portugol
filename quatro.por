algoritmo
declare
	num[15], i numerico
para i <- 1 ate 15 faca
	inicio
		escreva "Entre com o numero: "
		leia num[i]
	fim
	escreva "Numeros digitados: "
para i <- 1 ate 6 faca
	inicio
		escreva "-",num[i]
	fim
para i <- 1 ate 15 faca
		
		inicio
		se(num[i]=30) entao
			inicio
			escreva " O numero 30 está na posicao: ", i
		fim
		fim
		
		
fim_algoritmo.
