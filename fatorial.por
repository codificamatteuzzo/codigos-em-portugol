algoritmo
declare x
,y numerico
escreva "Calculando o Fatorial..."
escreva "Qual fatorial deseja fazer: "
leia x
y <- x
escreva "O resultado do Fatorial: ", x
enquanto (y > 1) faca
			     inicio
				    escreva x
				    y <- (y - 1)
				    x <- x * y
			     fim
escreva "Portanto o resultado do Fatorial: ", x
fim_algoritmo
