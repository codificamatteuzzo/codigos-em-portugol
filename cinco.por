algoritmo
declare
	v1[10], v2[10], v3[10], i numerico
para i <- 1 ate 10 faca
	inicio
		escreva "Entre com o numero v1: "
		leia v1[i]
	fim
para i <- 1 ate 10 faca
	inicio
		escreva "Entre com o numero v2: "
		leia v2[i]
	fim
	
para i <- 1 ate 10 faca
	inicio
		v3[i] <- v1[i] * v2[i]
	fim
para i <- 1 ate 10 faca
	inicio
		escreva "Resultado em V3 da posicao [",i, "] = ",v3[i] 
	fim
		
		
fim_algoritmo.
